# =============================================================
# ONE Backend 환경 변수 템플릿
# 이 파일을 복사해서 .env 로 만든 뒤 값을 채워주세요
# cp .env.example .env
# =============================================================

# -------------------------------------------------------------
# DB 설정
# local 프로파일은 아래 기본값으로 동작하므로 생략 가능
# prod 프로파일은 반드시 설정 필요
# -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=one
DB_USERNAME=one
DB_PASSWORD=one

# -------------------------------------------------------------
# JWT 설정
# secret: 32자 이상 랜덤 문자열 권장
# expiration: 밀리초 단위 (3600000 = 1시간, 1209600000 = 14일)
# -------------------------------------------------------------
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_32_CHAR_STRING
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# -------------------------------------------------------------
# CORS 허용 출처
# 여러 개인 경우 콤마로 구분 (예: https://a.com,https://b.com)
# -------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -------------------------------------------------------------
# MinIO 오브젝트 스토리지 설정
# local: 로컬 MinIO 서버 또는 개발용 엔드포인트 입력
# prod:  반드시 실제 서버 주소 및 인증 정보로 교체
# MINIO_PRESIGNED_EXPIRY: Presigned URL 유효 시간 (초, 기본 3600 = 1시간)
# -------------------------------------------------------------
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=one-files
MINIO_PRESIGNED_EXPIRY=3600
